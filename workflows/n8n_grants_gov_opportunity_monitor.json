{
  "name": "Daily Grants.gov Opportunity Monitor to Slack or Discord",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "44444444-0000-0000-0000-000000000001",
      "name": "Every 24 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/captainhandsome~grants-gov-opportunity-search/run-sync-get-dataset-items?clean=true&format=json&timeout=300&maxItems=10",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"keyword\": \"small business innovation research\",\n  \"statuses\": [\"posted\"],\n  \"include_details\": true,\n  \"max_items\": 10\n}",
        "options": {}
      },
      "id": "44444444-0000-0000-0000-000000000002",
      "name": "Search Grants.gov",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore.seen = store.seen || {};\nconst output = [];\nfor (const item of $input.all()) {\n  const rows = Array.isArray(item.json) ? item.json : [item.json];\n  for (const row of rows) {\n    const key = row.opportunity_number || row.grants_gov_url || row.title;\n    if (key && !store.seen[key]) {\n      store.seen[key] = Date.now();\n      output.push({ json: row });\n    }\n  }\n}\nconst newest = Object.entries(store.seen).sort((a, b) => b[1] - a[1]).slice(0, 1000);\nstore.seen = Object.fromEntries(newest);\nreturn output;"
      },
      "id": "44444444-0000-0000-0000-000000000005",
      "name": "Only New Opportunities",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "YOUR_SLACK_OR_DISCORD_WEBHOOK_URL",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ text: '*New Grants.gov opportunity*\\n*Title:* ' + $json.title + '\\n*Agency:* ' + $json.agency_name + '\\n*Closes:* ' + $json.close_date + '\\n*Opportunity:* ' + $json.opportunity_number + '\\n*Link:* ' + $json.grants_gov_url }) }}",
        "options": {}
      },
      "id": "44444444-0000-0000-0000-000000000006",
      "name": "Send Grant Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        920,
        300
      ]
    }
  ],
  "connections": {
    "Every 24 Hours": {
      "main": [
        [
          {
            "node": "Search Grants.gov",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search Grants.gov": {
      "main": [
        [
          {
            "node": "Only New Opportunities",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only New Opportunities": {
      "main": [
        [
          {
            "node": "Send Grant Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "meta": {
    "templateId": "apify-grants-gov-opportunity-monitor",
    "instanceId": "community-template",
    "description": "Monitor posted Grants.gov opportunities with captainhandsome/grants-gov-opportunity-search, suppress previously seen notices, and send new funding links to Slack or Discord."
  }
}

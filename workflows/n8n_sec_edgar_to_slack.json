{
  "name": "SEC EDGAR 10-K & 8-K Filing Monitor to Slack / Discord Webhook",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 4
            }
          ]
        }
      },
      "id": "22222222-0000-0000-0000-000000000001",
      "name": "Every 4 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/captainhandsome~sec-edgar-filings-search/run-sync-get-dataset-items?clean=true&format=json&timeout=300&maxItems=10",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"companies\": [\"AAPL\", \"MSFT\", \"NVDA\", \"TSLA\"],\n  \"forms\": [\"10-K\", \"8-K\"],\n  \"max_items\": 10\n}",
        "options": {}
      },
      "id": "22222222-0000-0000-0000-000000000002",
      "name": "Search SEC EDGAR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore.seen = store.seen || {};\nconst output = [];\nfor (const item of $input.all()) {\n  const rows = Array.isArray(item.json) ? item.json : [item.json];\n  for (const row of rows) {\n    const key = row.accession_number || row.filing_url || (row.company_name + '|' + row.form + '|' + row.filing_date);\n    if (key && !store.seen[key]) {\n      store.seen[key] = Date.now();\n      output.push({ json: row });\n    }\n  }\n}\nconst newest = Object.entries(store.seen).sort((a, b) => b[1] - a[1]).slice(0, 2000);\nstore.seen = Object.fromEntries(newest);\nreturn output;"
      },
      "id": "22222222-0000-0000-0000-000000000003",
      "name": "Only New Filings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "YOUR_SLACK_OR_DISCORD_WEBHOOK_URL",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"text\": \"*New SEC Filing Detected*\\n*Company:* {{ $json.company_name }} ({{ $json.ticker }})\\n*Form:* {{ $json.form }}\\n*Filed:* {{ $json.filing_date }}\\n*Link:* {{ $json.filing_url }}\"\n}",
        "options": {}
      },
      "id": "22222222-0000-0000-0000-000000000005",
      "name": "Send Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        920,
        300
      ]
    }
  ],
  "connections": {
    "Every 4 Hours": {
      "main": [
        [
          {
            "node": "Search SEC EDGAR",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search SEC EDGAR": {
      "main": [
        [
          {
            "node": "Only New Filings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only New Filings": {
      "main": [
        [
          {
            "node": "Send Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "meta": {
    "templateId": "apify-sec-edgar-filing-alerts",
    "instanceId": "community-template",
    "description": "Monitor real-time SEC 10-K and 8-K material event filings for target stock tickers using captainhandsome/sec-edgar-filings-search and dispatch instant webhook alerts."
  }
}

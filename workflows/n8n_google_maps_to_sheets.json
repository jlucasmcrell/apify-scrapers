{
  "name": "Export Google Maps Leads to Google Sheets on a Schedule",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1
            }
          ]
        }
      },
      "id": "11111111-0000-0000-0000-000000000001",
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/captainhandsome~google-maps-business-search/run-sync-get-dataset-items?clean=true&format=json&timeout=300&maxItems=50",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"search_query\": \"commercial electricians\",\n  \"location\": \"Dallas, Texas\",\n  \"max_items\": 50,\n  \"include_details\": true\n}",
        "options": {}
      },
      "id": "11111111-0000-0000-0000-000000000002",
      "name": "Start Google Maps Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore.seen = store.seen || {};\nconst output = [];\nfor (const item of $input.all()) {\n  const rows = Array.isArray(item.json) ? item.json : [item.json];\n  for (const row of rows) {\n    const key = row.place_id || row.place_url || (row.name + '|' + row.address);\n    if (key && !store.seen[key]) {\n      store.seen[key] = Date.now();\n      output.push({ json: row });\n    }\n  }\n}\nconst newest = Object.entries(store.seen).sort((a, b) => b[1] - a[1]).slice(0, 5000);\nstore.seen = Object.fromEntries(newest);\nreturn output;"
      },
      "id": "11111111-0000-0000-0000-000000000003",
      "name": "Only New Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "11111111-0000-0000-0000-000000000005",
      "name": "Append to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        920,
        300
      ]
    }
  ],
  "connections": {
    "Weekly Trigger": {
      "main": [
        [
          {
            "node": "Start Google Maps Scraper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Google Maps Scraper": {
      "main": [
        [
          {
            "node": "Only New Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only New Leads": {
      "main": [
        [
          {
            "node": "Append to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "meta": {
    "templateId": "apify-google-maps-to-sheets",
    "instanceId": "community-template",
    "description": "Automatically extract business leads (name, phone, address, rating, website) using captainhandsome/google-maps-business-search on Apify and append them to Google Sheets."
  }
}
